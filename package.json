{
  "name": "dsh-weather-badge",
  "version": "1.3.1",
  "description": "天气预报插件：给 Agent 一个 weather 工具，并在侧栏账号旁常驻时钟与天气表盘，点开即主面板天气页（Open-Meteo 免费数据，无需 API Key）· Weather tool + clock/weather dials for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "weather",
    "forecast",
    "open-meteo",
    "clock",
    "天气",
    "天气预报"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henry1996-yl/dsh-weather-badge.git"
  },
  "homepage": "https://github.com/henry1996-yl/dsh-weather-badge#readme",
  "bugs": {
    "url": "https://github.com/henry1996-yl/dsh-weather-badge/issues"
  },
  "author": "henry1996-yl",
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  }
}